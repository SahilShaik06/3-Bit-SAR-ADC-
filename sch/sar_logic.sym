T {reset_neg} -125 -14 0 0 0.2 0.2 {}
B 5 147.5 7.5 152.5 12.5 {name=done dir=out}
L 4 130 10 150 10 {}
T {done} 125 6 0 1 0.2 0.2 {}
B 5 -152.5 7.5 -147.5 12.5 {name=start dir=in}

T {start} -125 6 0 0 0.2 0.2 {}
B 5 -152.5 27.5 -147.5 32.5 {name=comp_out dir=in}
L 4 -150 30 -130 30 {}
T {comp_out} -125 26 0 0 0.2 0.2 {}
